# WebRTC STUN servers (comma-separated). Defaults to public Google STUN servers.
VITE_STUN_URLS=

# Optional TURN server for reliable WebRTC on restrictive networks (comma-separated URLs)
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_PASSWORD=

# Backend server URL used by the Vite dev-server proxy (default: http://127.0.0.1:3000)
VITE_BACKEND_URL=http://127.0.0.1:3000

# Comma-separated list of additional origins allowed to post OAuth popup messages.
# Defaults to localhost/127.0.0.1 dev origins when unset.
VITE_ALLOWED_ORIGINS=