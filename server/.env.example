# Frontend origin(s) allowed for CORS and OAuth postMessage.
# Use one URL or a comma-separated list. APP_URL is also the fallback return origin.
APP_URL=http://localhost:5173
CLIENT_URL=
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Public backend origin. Set this when a proxy prevents the callback URL from
# being derived from the request; otherwise the request protocol/host is used.
SERVER_URL=
# Explicit Google OAuth redirect URI override (must match Google Cloud Console).
GOOGLE_CALLBACK_URL=

# Google OAuth Credentials for user login
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# MongoDB Database Connection (required: the server connects at startup and
# will not listen if MongoDB is unreachable; there is no in-memory fallback)
MONGODB_URI=mongodb://127.0.0.1:27017/whiteboard

# Server Port. Leave unset on platforms such as Render/Railway that inject PORT.
PORT=3000

# Only trust X-Forwarded-For when deployed behind a known number of proxies.
# Leave blank/false for direct exposure; set 1 for one hop (Render/Railway/nginx).
# "true" is rejected: a client-controlled header would make rate limits spoofable.
TRUST_PROXY=

# HTTP request and header timeouts in milliseconds (headers must exceed request).
HTTP_REQUEST_TIMEOUT_MS=60000
HTTP_HEADERS_TIMEOUT_MS=65000

# Bound AI work so overload returns HTTP 429 and cached graphs stay memory-safe.
AI_QUEUE_MAX_DEPTH=24
AI_CACHE_MAX_ENTRIES=256

# AI provider selection: auto, gemini, groq, nvidia, openrouter, deepseek, ollama, or fallback.
AI_PROVIDER=gemini

# Google Gemini API Key for AI Diagram & Mind Map Generation
GEMINI_API_KEY=
# Gemini model name (first model in the failover chain)
GEMINI_MODEL=gemini-3.8-flash
# Comma-separated Gemini fallback models; use `none` to disable failover.
GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest,gemini-3.6-flash
# Per-attempt Gemini request timeout in milliseconds.
GEMINI_TIMEOUT_MS=45000
# Set to false to stop cloud/auto mode from falling back to local Ollama.
AI_ALLOW_OLLAMA_FALLBACK=true

# Additional OpenAI-compatible AI providers (optional — leave empty to disable)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=qwen/qwen3.8-27b

NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=minimaxai/minimax-m3.1-flash

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=baidu/ernie-5.5-flash-preview:free

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Local/remote Ollama settings
OLLAMA_MODEL=llama3.2
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TIMEOUT_MS=180000
OLLAMA_NUM_CTX=12288
OLLAMA_NUM_PREDICT=6144
OLLAMA_KEEP_ALIVE=10m
OLLAMA_MIN_INTERVAL_MS=250
OLLAMA_API_KEY=

# Vote-to-clear countdown duration in milliseconds
VOTE_CLEAR_DURATION_MS=15000
