# APP_URL / CLIENT_URL: The URL where the frontend client is hosted (used for CORS and OAuth redirect)
# For multiple domains, provide comma-separated URLs (e.g. http://localhost:5173,https://my-app.vercel.app)
APP_URL=http://localhost:5173

# Google OAuth Credentials for user login
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# MongoDB Database Connection
MONGODB_URI=mongodb://127.0.0.1:27017/whiteboard

# Server Port
PORT=3000

# Only trust X-Forwarded-For when deployed behind a known number of proxies.
# Leave blank/false for direct exposure; set 1 for one hop (Render/Railway/nginx).
TRUST_PROXY=

# HTTP request and header timeouts in milliseconds (headers must exceed request).
HTTP_REQUEST_TIMEOUT_MS=60000
HTTP_HEADERS_TIMEOUT_MS=65000

# Bound AI work so overload returns HTTP 429 and cached graphs stay memory-safe.
AI_QUEUE_MAX_DEPTH=24
AI_CACHE_MAX_ENTRIES=256

# Google Gemini API Key for AI Diagram & Mind Map Generation
GEMINI_API_KEY=
# Gemini model name (override when Google retires or replaces a model)
GEMINI_MODEL=gemini-3.8-flash

# Vote-to-clear countdown duration in milliseconds
VOTE_CLEAR_DURATION_MS=15000
