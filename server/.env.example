# Frontend origin(s) allowed for CORS and OAuth postMessage.
# Use one URL or a comma-separated list. APP_URL is also the fallback return origin.
APP_URL=http://localhost:5173
CLIENT_URL=
ALLOWED_ORIGINS=

# Public backend origin. Set this when a proxy prevents the callback URL from
# being derived from the request; otherwise the request protocol/host is used.
SERVER_URL=
# Explicit Google OAuth redirect URI override (must match Google Cloud Console).
GOOGLE_CALLBACK_URL=

# Google OAuth Credentials for user login
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# MongoDB Database Connection (required: the server connects at startup and
# will not listen if MongoDB is unreachable; there is no in-memory fallback)
MONGODB_URI=mongodb://127.0.0.1:27017/whiteboard

# Server Port. Leave unset on platforms such as Render/Railway that inject PORT.
PORT=3000

# AI provider selection: gemini, ollama, or auto (unset).
AI_PROVIDER=gemini

# Google Gemini API Key for AI Diagram & Mind Map Generation
GEMINI_API_KEY=
# Gemini model name (first model in the failover chain)
GEMINI_MODEL=gemini-3.8-flash
# Comma-separated Gemini fallback models; use `none` to disable failover.
GEMINI_FALLBACK_MODELS=gemini-3.6-flash
# Per-attempt Gemini request timeout in milliseconds.
GEMINI_TIMEOUT_MS=45000
# Set to false to prevent Ollama fallback when auto mode is used.
AI_ALLOW_OLLAMA_FALLBACK=true

# Local/remote Ollama settings
OLLAMA_MODEL=llama3.2
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TIMEOUT_MS=180000
OLLAMA_NUM_CTX=12288
OLLAMA_NUM_PREDICT=6144
OLLAMA_KEEP_ALIVE=10m
OLLAMA_MIN_INTERVAL_MS=250
OLLAMA_API_KEY=

# Vote-to-clear countdown duration in milliseconds
VOTE_CLEAR_DURATION_MS=15000
