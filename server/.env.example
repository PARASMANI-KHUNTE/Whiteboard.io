# APP_URL / CLIENT_URL: The URL where the frontend client is hosted (used for CORS and OAuth redirect)
# For multiple domains, provide comma-separated URLs (e.g. http://localhost:5173,https://my-app.vercel.app)
APP_URL=http://localhost:5173

# Google OAuth Credentials for user login
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# MongoDB Database Connection
MONGODB_URI=mongodb://127.0.0.1:27017/whiteboard

# Server Port
PORT=3000

# Google Gemini API Key for AI Diagram & Mind Map Generation
GEMINI_API_KEY=

# Vote-to-clear countdown duration in milliseconds
VOTE_CLEAR_DURATION_MS=15000

